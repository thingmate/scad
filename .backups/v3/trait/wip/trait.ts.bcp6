export type Typed<GType extends string, GProperties extends object> = GProperties & {
  readonly $type: GType;
};

/*--*/

export interface TypedDefinition<GType extends string, GProperties extends object> {
  readonly $typed: Typed<GType, GProperties>;

  create(properties: GProperties): Typed<GType, GProperties>;

  implementation<GFunction extends (self: Typed<GType, GProperties>, ...args: any[]) => any>(
    fnc: GFunction,
  ): Implementation<GType, GFunction>;
}

export type PartialTyped<GType extends string> = <GProperties extends object>() => TypedDefinition<
  GType,
  GProperties
>;

export function typed<GType extends string>($type: GType): PartialTyped<GType> {
  return <GProperties extends object>(): TypedDefinition<GType, GProperties> => {
    return {
      create(properties: GProperties): Typed<GType, GProperties> {
        return { ...properties, $type };
      },
    };
  };
}

/*--*/

export type Implementation<
  GType extends string,
  GFunction extends (self: Typed<any, any>, ...args: any[]) => any,
> = GFunction & {
  readonly $for: GType;
};

