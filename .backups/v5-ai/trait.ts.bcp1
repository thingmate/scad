import type { Typed } from './traits/src/typed.ts';

/*---------*/

export interface Translate {
  <GSelf extends Typed>(self: GSelf, x: number, y?: number, z?: number): GSelf;
}

/*---*/

const VEC3 = Symbol('VEC3');

export interface Vec3 extends Typed<typeof VEC3> {
  readonly x: number;
  readonly y: number;
  readonly z: number;
}

/*---*/

export type TraitDefinitionConstraint = <GSelf extends Typed>(self: GSelf, ...args: any) => any;

// TypeScript has no higher-kinded types: `GFnc<GSelf>` is not expressible, and
// matching a generic definition instantiates its own type parameter to its
// constraint, which surfaces as exactly `Typed<any>`. Such positions are
// re-bound to the implementation's `GSelf`, while concrete `Typed` subtypes
// declared by the definition are preserved.
export type RebindTypeParam<TArg, GSelf extends Typed> = [TArg] extends [Typed<any>]
  ? [Typed<any>] extends [TArg]
    ? GSelf
    : TArg
  : TArg extends readonly unknown[]
    ? { [GArgKey in keyof TArg]: RebindTypeParam<TArg[GArgKey], GSelf> }
    : TArg;

export type TraitDefinitionArgs<
  GTraitDefinition extends TraitDefinitionConstraint,
  GSelf extends Typed,
> = GTraitDefinition extends (self: any, ...args: infer GArgs) => any
  ? { [GArgKey in keyof GArgs]: RebindTypeParam<GArgs[GArgKey], GSelf> }
  : never;

export type TraitDefinitionReturn<
  GTraitDefinition extends TraitDefinitionConstraint,
  GSelf extends Typed,
> = GTraitDefinition extends (self: any, ...args: any) => infer GReturn
  ? [GReturn] extends [Typed<any>]
    ? [Typed<any>] extends [GReturn]
      ? GSelf
      : GReturn
    : GReturn
  : never;

export type TraitImplementation<
  GTraitDefinition extends TraitDefinitionConstraint,
  GSelf extends Typed,
> = (
  self: GSelf,
  ...args: TraitDefinitionArgs<GTraitDefinition, GSelf>
) => TraitDefinitionReturn<GTraitDefinition, GSelf>;

export type Trait<GTraitDefinition extends TraitDefinitionConstraint> = GTraitDefinition & {
  implement<GSelf extends Typed>(
    $type: GSelf['$type'],
    implementation: TraitImplementation<GTraitDefinition, GSelf>,
  ): void;
};

export function trait<
  GTraitDefinition extends TraitDefinitionConstraint,
>(): Trait<GTraitDefinition> {
  const implementations = new Map<symbol, (...args: any) => any>();

  return Object.assign(
    (self: Typed, ...args: any[]): any => {
      return implementations.get(self.$type)!(self, ...args);
    },
    {
      implement<GSelf extends Typed>(
        $type: GSelf['$type'],
        implementation: (...args: any) => any,
      ): void {
        if (implementations.has($type)) {
          throw new Error(`Trait already implemented for type ${String($type)}.`);
        }
        implementations.set($type, implementation);
      },
    },
  ) as Trait<GTraitDefinition>;
}

/*---*/

const translate = trait<Translate>();

translate.implement(VEC3, (self: Vec3, x: number, y: number = 0, z: number = 0): Vec3 => {
  return { ...self, x: self.x + x, y: self.y + y, z: self.z + z };
});

